HOST=0.0.0.0
PORT=3001

# Database configuration
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<db>?schema=auth

# Initial Owner created by `pnpm prisma:seed` (TES-81). Never commit real values.
OWNER_EMAIL=owner@pyme.test
OWNER_PASSWORD=<min 12 characters>
OWNER_NAME=<name>
OWNER_SURNAME=<surname>

# Access token lifetime in seconds (1800 = 30 minutes)
JWT_EXPIRES_IN=1800

# Generate with: openssl rand -base64 48
JWT_SECRET=