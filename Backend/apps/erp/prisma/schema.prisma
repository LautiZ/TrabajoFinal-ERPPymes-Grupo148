generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["erp"]
}

enum ProductUnit {
  Unit
  Kg
  Meter
  Liter

  @@map("product_units")
  @@schema("erp")
}

enum MovementType {
  Income
  Outcome
  Adjustment

  @@map("type_movements")
  @@schema("erp")
}

enum SaleState {
  Ordered
  Paid
  Dispatched
  Cancelled

  @@map("sale_states")
  @@schema("erp")
}

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar
  description String?  @db.VarChar
  deleted     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  products Product[]

  // Natural key: unique among non-deleted categories (RN-19)
  @@unique([name], map: "uq_categories_name_active", where: raw("deleted = false"))
  @@map("categories")
  @@schema("erp")
}

model Product {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String      @db.VarChar
  sku        String      @unique(map: "uq_products_sku") @db.VarChar
  price      Decimal     @db.Decimal(12, 2)
  stock      Decimal     @default(0) @db.Decimal(12, 3)
  unit       ProductUnit @default(Unit)
  categoryId String      @map("category_id") @db.Uuid
  active     Boolean     @default(true)
  deleted    Boolean     @default(false)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict, map: "fk_products_category_id")
  stockMovements StockMovement[]
  saleItems      SaleItem[]

  @@index([categoryId], map: "idx_products_category_id")
  @@map("products")
  @@schema("erp")
}

model Sale {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Natural key: ticket number, generated by a sequence, never sent by the client
  saleNumber   Int       @unique(map: "uq_sales_sale_number") @default(autoincrement()) @map("sale_number")
  total        Decimal   @db.Decimal(12, 2)
  // Cross-service reference to auth.users.id: no FK on purpose
  userId       String    @map("user_id") @db.Uuid
  currentState SaleState @map("current_state")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  items          SaleItem[]
  stockMovements StockMovement[]
  history        SaleHistory[]

  @@index([createdAt], map: "idx_sales_created_at")
  @@index([currentState, createdAt], map: "idx_sales_current_state_created_at")
  @@index([userId], map: "idx_sales_user_id")
  @@map("sales")
  @@schema("erp")
}

model StockMovement {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  typeMovement MovementType @map("type_movement")
  quantity     Decimal      @db.Decimal(12, 3)
  // Cross-service reference to auth.users.id: no FK on purpose
  userId       String       @map("user_id") @db.Uuid
  saleId       String?      @map("sale_id") @db.Uuid
  productId    String       @map("product_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz

  sale    Sale?   @relation(fields: [saleId], references: [id], onDelete: Restrict, map: "fk_stock_movements_sale_id")
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict, map: "fk_stock_movements_product_id")

  @@index([productId, createdAt], map: "idx_stock_movements_product_id_created_at")
  @@index([saleId], map: "idx_stock_movements_sale_id")
  @@map("stock_movements")
  @@schema("erp")
}

model SaleItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  saleId    String  @map("sale_id") @db.Uuid
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict, map: "fk_sale_items_product_id")
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Restrict, map: "fk_sale_items_sale_id")

  @@unique([saleId, productId], map: "uq_sale_items_sale_id_product_id")
  @@index([productId], map: "idx_sale_items_product_id")
  @@map("sale_items")
  @@schema("erp")
}

model SaleHistory {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleState SaleState @map("sale_state")
  // Cross-service reference to auth.users.id: no FK on purpose
  userId    String?   @map("user_id") @db.Uuid
  saleId    String    @map("sale_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict, map: "fk_sale_history_sale_id")

  // Natural key: a sale goes through each state only once (RN-09)
  @@unique([saleId, saleState], map: "uq_sale_history_sale_id_sale_state")
  @@index([saleId, createdAt], map: "idx_sale_history_sale_id_created_at")
  @@map("sale_history")
  @@schema("erp")
}
